# Адрес демо-запроса главной страницы (каркас), к API DejaView не относится
VITE_API_URL=https://api.example.com
# Хост dev-сервера Vite
VITE_URL=localhost
# Порт dev-сервера и preview
VITE_PORT=5173

# Базовый адрес API вместе с /api/v1; по умолчанию /api/v1 на том же домене, что и сайт
VITE_API_BASE_URL=/api/v1
# true — ответы API из заглушек вместо сервера; только для .env.development.local
VITE_API_MOCKS=false
# Адрес backend для proxy pnpm start:dev и pnpm start:prod: запросы /api/v1 уходят туда; без переменной proxy выключен
# VITE_API_PROXY_TARGET=http://localhost:8080
